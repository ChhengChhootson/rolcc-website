APP_NAME="ROLCC Cambodia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rolcccambodia.org
APP_TIMEZONE=Asia/Phnom_Penh
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rolcc_cambodia
DB_USERNAME=rolcc_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=rolcc_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@rolcccambodia.org"
MAIL_FROM_NAME="ROLCC Cambodia"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Google Analytics
GOOGLE_ANALYTICS_ID=

# reCAPTCHA
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# YouTube API
YOUTUBE_API_KEY=

# Facebook App
FACEBOOK_APP_ID=
FACEBOOK_PAGE_ID=

# Admin Config
ADMIN_EMAIL=admin@rolcccambodia.org
SUPER_ADMIN_EMAIL=superadmin@rolcccambodia.org

# Church Config
CHURCH_NAME="River of Life Christian Church Cambodia"
CHURCH_PHONE="+855 12 345 678"
CHURCH_EMAIL="info@rolcccambodia.org"
CHURCH_ADDRESS="Phnom Penh, Cambodia"
